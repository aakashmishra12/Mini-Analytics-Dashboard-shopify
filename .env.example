# ─────────────────────────────────────────────────────────────
# Mini Analytics Dashboard — environment reference
#
# This root file documents every variable used by the project.
# For local development, copy the two service-level files instead:
#   cp backend/.env.example  backend/.env
#   cp frontend/.env.example frontend/.env
# ─────────────────────────────────────────────────────────────

# ── Backend (backend/.env) ───────────────────────────────────

PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins, or * for any.
CORS_ORIGIN=http://localhost:5173

# Shopify Admin API credentials.
# Leave blank to run on the bundled demo dataset.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-01

# Force the demo dataset even when credentials are present.
# If unset and credentials are missing, demo data is used automatically.
USE_MOCK_DATA=true

# How long a fetched store snapshot stays fresh before refetching.
CACHE_TTL_MINUTES=15

# Inventory thresholds used by /api/inventory and the distribution chart.
LOW_INVENTORY_THRESHOLD=10
CRITICAL_INVENTORY_THRESHOLD=5


# ── Frontend (frontend/.env) ─────────────────────────────────

# Where the browser sends API calls.
# Local dev: leave as /api and let the Vite proxy forward to the backend.
# Production: set the full backend URL, e.g. https://your-api.onrender.com/api
VITE_API_BASE_URL=/api
